# Copy to .env and replace every value. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fintrack
DB_USERNAME=fintrack_user
DB_PASSWORD=change-me-db-password
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGIN=http://localhost:5173
